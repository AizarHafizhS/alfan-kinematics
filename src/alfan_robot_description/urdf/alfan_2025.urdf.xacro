<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alfan_2025">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import alfan_2025 urdf file -->
    <xacro:include filename="$(find alfan_robot_description)/urdf/alfan.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="alfan_2025.ros2_control.xacro" />


    <xacro:alfan_2025_ros2_control name="GazeboROS2" initial_positions_file="$(arg initial_positions_file)"/>

    <gazebo>
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <parameters>$(find alfan_hardware)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <gazebo reference="l_foot">
        <mu1>100.0</mu1>
        <mu2>100.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>
  
    <gazebo reference="r_foot">
        <mu1>100.0</mu1>
        <mu2>100.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="l_palm">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.0001</minDepth>
        <maxVel>0.01</maxVel>
    </gazebo>
    
    <gazebo reference="r_palm">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.0001</minDepth>
        <maxVel>0.01</maxVel>
    </gazebo>

</robot>
