<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ax12_interface" params="joint_name initial_pos p_gain d_gain effort">
        <joint name="${joint_name}">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">${initial_pos}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <param name="p">${p_gain}</param>
            <param name="d">${d_gain}</param>
            <param name="max_effort">${effort}</param>
        </joint>
    </xacro:macro>

    <xacro:macro name="bioloid_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>

            <xacro:ax12_interface joint_name="r_hand_roll" initial_pos="${initial_positions['r_hand_roll']}" p_gain="100.0" d_gain="1.0" effort="10.0"/>
            <xacro:ax12_interface joint_name="l_hand_roll" initial_pos="${initial_positions['l_hand_roll']}" p_gain="100.0" d_gain="1.0" effort="10.0"/>

            <xacro:ax12_interface joint_name="r_hip_yaw"     initial_pos="${initial_positions['r_hip_yaw']}"     p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="r_hip_roll"    initial_pos="${initial_positions['r_hip_roll']}"    p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="r_hip_pitch"   initial_pos="${initial_positions['r_hip_pitch']}"   p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="r_knee"        initial_pos="${initial_positions['r_knee']}"        p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="r_ankle_pitch" initial_pos="${initial_positions['r_ankle_pitch']}" p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="r_ankle_roll"  initial_pos="${initial_positions['r_ankle_roll']}"  p_gain="2000.0" d_gain="20.0" effort="100.0"/>

            <xacro:ax12_interface joint_name="l_hip_yaw"     initial_pos="${initial_positions['l_hip_yaw']}"     p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="l_hip_roll"    initial_pos="${initial_positions['l_hip_roll']}"    p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="l_hip_pitch"   initial_pos="${initial_positions['l_hip_pitch']}"   p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="l_knee"        initial_pos="${initial_positions['l_knee']}"        p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="l_ankle_pitch" initial_pos="${initial_positions['l_ankle_pitch']}" p_gain="2000.0" d_gain="20.0" effort="100.0"/>
            <xacro:ax12_interface joint_name="l_ankle_roll"  initial_pos="${initial_positions['l_ankle_roll']}"  p_gain="2000.0" d_gain="20.0" effort="100.0"/>

            <sensor name="imu_sensor">
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
            </sensor>
        </ros2_control>
    </xacro:macro>
</robot>