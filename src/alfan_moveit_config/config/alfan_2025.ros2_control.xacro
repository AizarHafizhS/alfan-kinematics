                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="l_hand_31">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['l_hand_31']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="l_hand_32">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['l_hand_32']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="l_hand_33">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['l_hand_33']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="l_hand_34">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['l_hand_34']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="l_hand_35">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['l_hand_35']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="l_hand_36">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['l_hand_36']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hip_yaw">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hip_yaw']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
