<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="alfan_2025_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </hardware>
            <joint name="head_yaw">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['head_yaw']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="head_roll">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['head_roll']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hand_21">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hand_21']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hand_22">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hand_22']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hand_23">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hand_23']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hand_24">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hand_24']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hand_25">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hand_25']}</param>
                </state_interface>
                <!-- <state_interface name="velocity"/> -->
                <param name="p">20.0</param>
                <param name="d">0.5</param>
                <param name="max_effort">2.5</param>
            </joint>
            <joint name="r_hand_26">
                <command_interface name="position"/>
                <!-- <command_interface name="velocity"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['r_hand_26']}</param>
